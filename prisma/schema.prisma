generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS — Order Source, Order Status, Process Status
// ==========================================

enum OrderSource {
  BF // ByteForge Website / Shopify Orders
  WA // WhatsApp Orders
  RM // Manual / Retail / Direct Orders
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ProcessStatus {
  UNSHIPPED
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  RETURNED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                  String            @id @default(uuid())
  name                String
  email               String            @unique
  password            String
  role                String            @default("USER")
  status              String            @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  company             String?
  plan                String            @default("Free")
  planId              String?
  planRef             SaaSPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  licenseKey          String?
  expiresAt           DateTime?
  ordersThisMonth     Int               @default(0)
  messagesThisMonth   Int               @default(0)
  shopifyOrdersSynced Int               @default(0)
  lastUsageReset      DateTime          @default(now())
  twoFactorEnabled    Boolean           @default(false)
  twoFactorSecret     String?
  createdAt           DateTime          @default(now())
  settings            Settings?
  whatsappSession     WhatsappSession?
  templates           Template[]
  automations         Automation[]
  orders              Order[]
  whatsappPolls       WhatsappPoll[]
  licenseKeys         LicenseKey[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  loginHistories      LoginHistory[]
}

model Order {
  id                String        @id @default(uuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source            OrderSource   @default(BF)
  customer          String
  phone             String
  product           String
  quantity          Int           @default(1)
  amount            Float
  status            OrderStatus   @default(PENDING)
  processStatus     ProcessStatus @default(UNSHIPPED)
  notes             String?
  shopifyOrderId    String?       @unique
  orderNumber       Int?
  orderName         String?
  customerEmail     String?
  address1          String?
  address2          String?
  city              String?
  province          String?
  zip               String?
  country           String?
  shopifyCustomerId String?
  trackingNumber    String?
  courierName       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([source])
  @@index([status])
  @@index([processStatus])
  @@index([phone])
  @@index([customer])
  @@index([createdAt])
  @@index([orderNumber])
}

model Template {
  id          String       @id @default(uuid())
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  content     String
  automations Automation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

model Automation {
  id               String    @id @default(uuid())
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger          String    // e.g. "ORDER_CREATED", "ORDER_CONFIRMED", etc.
  isEnabled        Boolean   @default(false)
  templateId       String?
  template         Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  providerOverride String?   // "META", "WEB", or null/default
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, trigger])
}

model Settings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumber         String?
  isConnected            Boolean  @default(false)
  lastSync               DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  enabledProviders       String   @default("BOTH") // "META", "WEB", "BOTH"
  defaultProvider        String   @default("META")  // "META", "WEB"
  
  // Meta Configuration
  metaBusinessAccountId String?
  metaPhoneNumberId     String?
  metaAccessToken       String?  // Encrypted
  metaVerifyToken       String?
  metaConnected         Boolean  @default(false)
  shopifyDomain         String?

  // Shopify Webhook Configuration
  shopifyWebhookSecret  String?
  shopifyWebhookStatus  String   @default("INACTIVE") // "ACTIVE", "INACTIVE"
  shopifyLastWebhookAt      DateTime?
  shopifyConnectionHealth   String   @default("UNKNOWN") // "HEALTHY", "UNHEALTHY", "UNKNOWN"
  shopifyStoreDetected      Boolean  @default(false)
  
  // Poll & Method Settings
  confirmationMethod     String   @default("BUTTONS") // "BUTTONS", "POLLS", "CUSTOM"
  pollConfirmLabel       String   @default("✅ Yes Confirmed")
  pollCancelLabel        String   @default("❌ No Cancelled")
  createdAt              DateTime @default(now())

  // White Label Configuration
  logoUrl                String?
  brandName              String?
  companyName            String?
  emailFooter            String?
  whatsappBranding       String?
}

model WhatsappSession {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber    String?
  connected      Boolean   @default(false)
  lastSync       DateTime?
  sessionHealth  String    @default("Healthy") // Healthy, Unhealthy, N/A
  sessionData    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WhatsappPoll {
  id            String   @id @default(uuid())
  messageId     String   @unique
  orderId       String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionsJson   String   // JSON string storing choice configurations
  messageSecret String   // Cryptographic base64 message secret for decrypting poll votes
  remoteJid     String?  // The recipient JID
  provider      String   @default("WEB")
  phoneNumber   String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model LicenseKey {
  id           String    @id @default(uuid())
  key          String    @unique
  duration     String    // 1 Month, 3 Months, 6 Months, 12 Months, Lifetime
  status       String    @default("ACTIVE") // ACTIVE, DEACTIVATED, EXPIRED, UNUSED
  createdAt    DateTime  @default(now())
  activatedAt  DateTime?
  expiresAt    DateTime?
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  targetId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  type      String   @default("INFO") // INFO, WARNING, EXPIRE_WARNING, CRITICAL
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SaaSPlan {
  id             String    @id @default(uuid())
  name           String    @unique
  priceMonthly   Float
  priceYearly    Float
  durationDays   Int       @default(30)
  maxOrders      Int       @default(100)
  maxMessages    Int       @default(100)
  maxTemplates   Int       @default(10)
  maxAutomations Int       @default(5)
  maxSessions    Int       @default(1)
  features       String    @default("[]") // JSON string of features, e.g. ["WHITELABEL"]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  users          User[]
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Backup {
  id          String   @id @default(uuid())
  filename    String
  sizeBytes   Int
  status      String   @default("COMPLETED") // COMPLETED, FAILED
  createdById String?
  createdAt   DateTime @default(now())
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}